# Initial publication is an explicit allowlist. Local history is preserved,
# but evidence, handoffs, private state and operational tools are not published.
/*
!/.gitignore
!/README.md
!/LICENSE
!/script.channelsdvr.hub/
!/tests/
/tests/*
!/tests/test_data.py
!/tests/test_guide.py
!/tests/test_search.py
!/tests/test_library.py
!/tests/test_metrics.py
!/tests/test_ui_dispatch.py
!/tests/test_metadata_http.py
!/tests/test_metadata_models.py
!/tests/test_metadata_repository.py
!/tests/test_live_loader.py
!/tests/test_session.py
!/tests/test_package.py
!/tests/test_artwork_native.py
!/tests/test_native_playback.py
!/tests/test_series_manager.py
!/tests/test_release_builder.py
!/tools/
/tools/*
!/tools/test_offline.py
!/tools/build_alpha.py
!/docs/
/docs/*
!/docs/USERGUIDE.md
!/docs/DEVELOPMENT.md
!/docs/LIMITATIONS.md
!/docs/IDENTITY.md
!/docs/ALPHA-READINESS.md
!/docs/ALPHA-TESTING.md

# Defense in depth, including anything accidentally created within the package.
AGENTS.md
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.zip
profile/
.env
.env.*
.local/
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
